+//! Present inside the title's top-level window, on its owning UI thread.
+use std::sync::atomic::{AtomicUsize, Ordering};
+use windows::Win32::Foundation::{HWND, LPARAM, LRESULT, WPARAM};
+use windows::Win32::Graphics::Gdi::{BLACK_BRUSH, GetStockObject, HBRUSH};
+use windows::Win32::System::LibraryLoader::GetModuleHandleW;
+use windows::Win32::UI::WindowsAndMessaging::*;
+use windows::core::w;
+
+mod geometry;
+static TARGET: AtomicUsize = AtomicUsize::new(0);
+
+pub(super) fn enabled() -> bool {
+    std::env::var_os("VICTORY_FULLSCREEN").is_some_and(|v| v == "1")
+}
+
+pub(super) fn target() -> Option<HWND> {
+    let h = TARGET.load(Ordering::Acquire);
+    (h != 0).then_some(HWND(h as *mut _))
+}
+
+extern "system" fn child_proc(hwnd: HWND, message: u32, wp: WPARAM, lp: LPARAM) -> LRESULT {
+    if message == WM_NCHITTEST {
+        // Both children and the title belong to the same thread. Pass mouse
+        // input through to the original title window.
+        return LRESULT(HTTRANSPARENT as i32 as isize);
+    }
+    if message == WM_NCDESTROY {
+        let _ = TARGET.compare_exchange(hwnd.0 as usize, 0, Ordering::AcqRel, Ordering::Relaxed);
+    }
+    unsafe { DefWindowProcW(hwnd, message, wp, lp) }
+}
+
+/// Called with a live title HWND from its window-creation hook.
+pub fn attach_title_fullscreen(handle: usize) {
+    if target().is_some() { return; }
+    if let Err(error) = attach(HWND(handle as *mut _)) {
+        TARGET.store(handle, Ordering::Release);
+        tracing::warn!(%error, "fullscreen unavailable; using the original title window");
+    }
+}
+
+fn attach(title: HWND) -> windows::core::Result<()> {
+    // Use the coordinate system of the title's own UI thread for both the
+    // primary screen and its child windows, including under desktop scaling.
+    unsafe {
+        let sw = GetSystemMetrics(SM_CXSCREEN);
+        let sh = GetSystemMetrics(SM_CYSCREEN);
+        if sw <= 0 || sh <= 0 { return Err(windows::core::Error::empty()); }
+        let instance = GetModuleHandleW(None)?;
+        let class = w!("VIctoryAspectChild");
+        RegisterClassExW(&WNDCLASSEXW {
+            cbSize: size_of::<WNDCLASSEXW>() as u32,
+            lpfnWndProc: Some(child_proc),
+            hInstance: instance.into(),
+            lpszClassName: class,
+            hCursor: LoadCursorW(None, IDC_ARROW)?,
+            hbrBackground: HBRUSH(GetStockObject(BLACK_BRUSH).0),
+            ..Default::default()
+        });
+        // All output modes exposed by this build have a 16:9 aspect.
+        let (x, y, w, h) = geometry::fit(16, 9, sw as u32, sh as u32);
+        let backdrop = CreateWindowExW(WS_EX_NOPARENTNOTIFY, class, w!(""),
+            WS_CHILD | WS_CLIPCHILDREN, 0, 0, sw, sh, Some(title), None, Some(instance.into()), None)?;
+        let viewport = match CreateWindowExW(WS_EX_NOPARENTNOTIFY, class, w!(""), WS_CHILD | WS_VISIBLE,
+            x, y, w, h, Some(backdrop), None, Some(instance.into()), None) {
+            Ok(viewport) => viewport,
+            Err(error) => { let _ = DestroyWindow(backdrop); return Err(error); }
+        };
+        let old = GetWindowLongPtrW(title, GWL_STYLE);
+        let style = (old as u32 & !WS_OVERLAPPEDWINDOW.0) | WS_POPUP.0 | WS_CLIPCHILDREN.0;
+        SetWindowLongPtrW(title, GWL_STYLE, style as isize);
+        if let Err(error) = SetWindowPos(title, None, 0, 0, sw, sh,
+            SWP_NOZORDER | SWP_NOACTIVATE | SWP_FRAMECHANGED) {
+            SetWindowLongPtrW(title, GWL_STYLE, old);
+            let _ = DestroyWindow(backdrop);
+            return Err(error);
+        }
+        let _ = ShowWindow(backdrop, SW_SHOWNA);
+        TARGET.store(viewport.0 as usize, Ordering::Release);
+        tracing::info!(screen_width=sw, screen_height=sh, x,y, viewport_width=w, viewport_height=h,
+            "aspect-preserving borderless fullscreen on original title window");
+        Ok(())
+    }
+}
