+fn maybe_attach_fullscreen(hwnd: HWND) {
+    if !std::env::var_os("VICTORY_FULLSCREEN").is_some_and(|v| v == "1") { return; }
+    // The hook runs on the thread that owns this live title window.
+    unsafe {
+        if wm::GetWindowLongPtrW(hwnd, wm::GWL_STYLE) as u32 & wm::WS_CHILD != 0
+            || !wm::GetWindow(hwnd, wm::GW_OWNER).is_null() { return; }
+        let mut caption = [0u16; 64];
+        let n = wm::GetWindowTextW(hwnd, caption.as_mut_ptr(), caption.len() as i32);
+        if String::from_utf16_lossy(&caption[..n as usize]).eq_ignore_ascii_case("Americas") {
+            victory_gpu::attach_title_fullscreen(hwnd as usize);
+        }
+    }
 }
 
