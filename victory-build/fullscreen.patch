+/// Center a nonzero render size inside a nonzero monitor size.
+pub fn fit(width: u32, height: u32, screen_w: u32, screen_h: u32) -> (i32, i32, i32, i32) {
+    let (w, h) = if u64::from(screen_w) * u64::from(height)
+        > u64::from(screen_h) * u64::from(width)
+    {
+        ((u64::from(screen_h) * u64::from(width) / u64::from(height)) as u32, screen_h)
+    } else {
+        (screen_w, (u64::from(screen_w) * u64::from(height) / u64::from(width)) as u32)
+    };
+    (((screen_w - w) / 2) as i32, ((screen_h - h) / 2) as i32, w as i32, h as i32)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::fit;
+
+    #[test]
+    fn ultrawide_monitor_has_equal_side_bars() {
+        assert_eq!(fit(2560, 1440, 3440, 1440), (440, 0, 2560, 1440));
+        assert_eq!(fit(1920, 1080, 3440, 1440), (440, 0, 2560, 1440));
+    }
+
+    #[test]
+    fn other_aspects_fit_without_cropping() {
+        assert_eq!(fit(2560, 1440, 2560, 1440), (0, 0, 2560, 1440));
+        assert_eq!(fit(1920, 1080, 1920, 1200), (0, 60, 1920, 1080));
+        assert_eq!(fit(1920, 1080, 1080, 1920), (0, 656, 1080, 607));
+    }
+}
